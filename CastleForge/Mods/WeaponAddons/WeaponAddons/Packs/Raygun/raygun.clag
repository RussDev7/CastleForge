Firearm
$NAME:         Raygun
$AUTHOR:       RussDev7
$DESCRIPTION1: RAYGUUUUN
$DESCRIPTION2: Uses Bullets

; ==========================================================
; New Weapon IDs (Synthetic / Local-Only)
; ----------------------------------------------------------
; Creates a NEW item ID at runtime by cloning a vanilla class.
; - AS_NEW_ITEM / NEW_ITEM: enable synthetic item creation.
; - ITEM_ID: Desired numeric ID (0/omit = auto-assign + persist in config).
; Notes:
; - Synthetic IDs are kept vanilla-safe by your networking remaps/filters.
; ==========================================================
$AS_NEW_ITEM: true
$ITEM_ID:     204

; ==========================================================
; BASE CLASS TO CLONE (IMPORTANT)
; ----------------------------------------------------------
; SLOT_ID decides what vanilla behavior/class you inherit.
; - For true laser behavior, clone a laser gun class (e.g., PrecisionLaser).
; - Cloning Pistol gives pistol behavior (even if you tint projectile color).
; ==========================================================
$SLOT_ID: Pistol

; Ammo type this weapon consumes (enum name or numeric ID).
$AMMO_ID: Bullets

; ==========================================================
; Optional UI Icon Override
; ----------------------------------------------------------
; Priority order:
;  1) PNG icon (ICON) if enabled + found.
;  2) Render icon from MODEL (ICON_RENDER_MODEL) if enabled.
;  3) Fallback: Normal SLOT_ID icon (vanilla Draw2D / synthetic->base remap).
;
; PNG icon:
; - ICON: Path relative to pack folder (same folder as this .clag).
; - ICON_ENABLED: Defaults true if ICON is present.
; ==========================================================
$ICON:         icon.png
$ICON_ENABLED: true

; Render icon from the MODEL .xnb (only used if PNG icon is not used).
; - ICON_RENDER_SIZE: output texture size in pixels (default 64)
$ICON_RENDER_MODEL: true
$ICON_RENDER_SIZE:  64

; Optional: Icon render pose (degrees).
; Tips:
; - YAW:   Left/right spin.
; - PITCH: Tilt (helps avoid "top-down flat" look).
; - ROLL:  In-screen rotation (use 180 if model appears upside-down).
$ICON_RENDER_YAW_DEG:   -58
$ICON_RENDER_PITCH_DEG: -162
$ICON_RENDER_ROLL_DEG:  41

; Optional: Icon render placement (units = model radius).
; +X = right, -X = left.
; +Y = up,    -Y = down.
; +Z = toward camera, -Z = away.
$ICON_RENDER_OFFSET_X: -0.15
$ICON_RENDER_OFFSET_Y: 0.22
$ICON_RENDER_OFFSET_Z: 0

; Optional: Zoom (>1 zooms IN, <1 zooms OUT).
$ICON_RENDER_ZOOM: 1.0

; ==========================================================
; Assets / Sounds
; ----------------------------------------------------------
; MODEL:
; - Path relative to the pack folder.
; - Omit the .xnb extension.
;   (ex: models\raygun -> <Pack>\models\raygun.xnb)
;
; UseSound / ReloadSound:
; - Either a vanilla cue name (ex: LaserGun4, Teleport), OR
; - A file path relative to the pack folder (WAV/MP3).
;   Recommended: 16-bit PCM WAV (most compatible).
;
; Optional multi-cue sounds:
; - UseSounds / ReloadSounds are comma-separated.
; - UseSoundMode / ReloadSoundMode can be Single, Random, Cycle, or Sequence.
; - Single   = default, use UseSound / ReloadSound.
; - Random   = pick from UseSounds / ReloadSounds.
; - Cycle    = pick the next listed sound each time the weapon fires/reloads.
; - Sequence = play the whole list back-to-back from one trigger.
;              Useful for reload1 -> reload2 -> reload3 style reload chains.
; - UseSoundMode and ReloadSoundMode are independent, so shooting can stay
;   Random/Cycle while reloading uses Sequence.
; - If the plural list is missing, it falls back to the single sound.
;
;   Example:
;     $UseSound:     GunShot3
;     $UseSounds:    GunShot3, GunShot3Alt1, GunShot3Alt2
;     $UseSoundMode: Random
;
;   Example:
;     $ReloadSound:     GunReload
;     $ReloadSounds:    GunReload, GunReloadAlt1, sounds\reload_alt.wav
;     $ReloadSoundMode: Random
;
;   Example:
;     $ReloadSound:     GunReload
;     $ReloadSounds:    sounds\reload1.wav, sounds\reload2.wav, sounds\reload3.wav
;     $ReloadSoundMode: Sequence
;
; Knife / melee / tool swing sounds:
; - SWING_SFX is an alias for the weapon's use/shoot sound, but is clearer
;   when making knife or tool-style packs.
; - For a knife, pickaxe, axe, or spade pack, clone the matching vanilla class
;   with SLOT_ID, then use:
;     $SWING_SFX: sounds\swing.wav
; - Optional plural/random/cycle swing sounds are also supported:
;     $SWING_SOUNDS: sounds\swing1.wav, sounds\swing2.wav
;     $SWING_SOUND_MODE: Random
; - For firearm packs like this Raygun example, keep using UseSound.
;
; Backward-compatible aliases still work:
; - SHOOT_SFX / SHOT
; - RELOAD_SFX / RELOAD
; - SWING_SFX / MELEE_SFX
; ==========================================================
$MODEL: models\raygun
$UseSound:    sounds\shoot.wav
$ReloadSound: sounds\reload.wav

; Optional SFX tuning (only affects file-based SFX, not cue names).
; Volume: 0..1  (1.0 = full volume).
; Pitch:  -1..1 (0.0 = normal, + = higher, - = lower).
$SHOOT_VOL:    1.0
$SHOOT_PITCH:  0.0

$RELOAD_VOL:   1.0
$RELOAD_PITCH: 0.0

; ==========================================================
; Optional Avatar / Weapon Animations
; ----------------------------------------------------------
; Custom player-handling animation clips for this weapon.
; Paths are relative to this pack folder and should omit .xnb.
; Only uncomment fields for clips that actually exist.
;
; Flow:
; - SLOT_ID still chooses the vanilla animation set to inherit.
; - WeaponAddons registers these clips for ITEM_ID.
; - Missing clips fall back to SLOT_ID animations.
;
; Suggested folder:
;   animations\idle.xnb
;   animations\walk.xnb
;   animations\shoot.xnb
;   animations\reload.xnb
;   animations\shoulder.xnb
;   animations\shoulder_idle.xnb
;   animations\shoulder_walk.xnb
;   animations\shoulder_shoot.xnb
; ==========================================================
; $ANIM_IDLE:           animations\idle
; $ANIM_WALK:           animations\walk
; $ANIM_SHOOT:          animations\shoot
; $ANIM_RELOAD:         animations\reload
; $ANIM_SHOULDER:       animations\shoulder
; $ANIM_SHOULDER_IDLE:  animations\shoulder_idle
; $ANIM_SHOULDER_WALK:  animations\shoulder_walk
; $ANIM_SHOULDER_SHOOT: animations\shoulder_shoot

; ==========================================================
; Behavior
; ==========================================================
$AUTOMATIC: false

; ==========================================================
; Damage / Handling
; ==========================================================
$DAMAGE:             1800
$SELF_DAMAGE:        0.001
$INACCURACY_DEG:     0.01
$BULLETS_PER_SECOND: 8
$RECOIL_DEG:         3

; ==========================================================
; Ammo
; ==========================================================
$CLIP_SIZE:         20
$ROUNDS_PER_RELOAD: 20

; ==========================================================
; Projectile Tuning
; ==========================================================
$SECONDS_TO_RELOAD: 1
$BULLET_LIFETIME:   3
$BULLET_SPEED:      100

; ==========================================================
; Visuals
; ----------------------------------------------------------
; PROJECTILE_TYPE is only meaningful if your runtime uses it.
; PROJECTILE_COLOR sets TracerColor (0..1) from R,G,B (0..255).
; MODEL_COLOR1/2 are best-effort tints applied to supported classes.
; ==========================================================
$PROJECTILE_TYPE:  Laser
$PROJECTILE_COLOR: 0,255,64
$MODEL_COLOR1:     255,50,50
$MODEL_COLOR2:     30,30,30

; ==========================================================
; Optional Crafting Recipe (per-pack)
; ----------------------------------------------------------
; RECIPE_ENABLED:      Enable/disable this pack's recipe injection.
; RECIPE_TYPE:         Crafting tab (Recipe.RecipeTypes): Pistols,
                       Ammo, Explosives, Advanced, etc.
; RECIPE_OUTPUT_COUNT: Stack size produced.
; RECIPE_INGREDIENTS:  "ItemIdOrName:Count, ItemIdOrName:Count, ..."
;
; Placement:
; - RECIPE_INSERT_AFTER: Anchor recipe (result item) in the same
                         tab (also used for ordering).
; - RECIPE_INSERT_MODE:
;     AFTER    = Immediately after anchor (default).
;     RIGHT_OF = Draw to the right of anchor's row (UI layout patch),
                 while still inserting after it in the list.
; ==========================================================
$RECIPE_ENABLED:      true
$RECIPE_TYPE:         Pistols
$RECIPE_OUTPUT_COUNT: 1
$RECIPE_INGREDIENTS:  Iron:2, WoodBlock:2, SpaceRockInventory:1

$RECIPE_INSERT_AFTER: Pistol
$RECIPE_INSERT_MODE:  RIGHT_OF